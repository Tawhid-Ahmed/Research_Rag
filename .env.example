# ---------------------------------------------------------------------------
# arXiv RAG Assistant — environment configuration
# Copy to `.env` and fill in as needed. All values have sensible defaults;
# the free/open default path (Hugging Face + Chroma) needs no secrets.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM provider: openai | anthropic | huggingface | ollama ---
LLM_PROVIDER=huggingface
LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Optional API keys (only set the one matching LLM_PROVIDER). Leave blank to
# stay on the free/open path. NEVER commit real keys.
# Note: Hugging Face Inference now uses router.huggingface.co and typically
# needs a free HF token (HUGGINGFACE_API_KEY) even on the free tier.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
# Local Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings & retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MIN_CONFIDENCE_SCORE=0.2

# --- Vector store: chroma | pgvector ---
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=arxiv_papers
# Used only when VECTOR_STORE=pgvector (the docker-compose pgvector profile).
POSTGRES_DSN=postgresql://rag:rag@localhost:5432/arxiv_rag

# --- Data paths ---
DATA_DIR=./data
PDF_CACHE_DIR=./data/pdfs

# --- Observability (optional, Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
